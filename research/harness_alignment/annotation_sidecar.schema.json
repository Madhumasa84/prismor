{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string",
            "pattern": "^review-[0-9]+$"
          },
          "case_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rubric_version": {
            "const": "harness-authorization-v1"
          },
          "status": {
            "enum": [
              "draft",
              "submitted"
            ]
          },
          "reviewer_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "enum": [
              "allow",
              "deny",
              "missing_authorization",
              "unresolved_semantics",
              null
            ]
          },
          "rationale": {
            "type": "string"
          },
          "ambiguous": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "review_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "review_id",
          "case_sha256",
          "input_sha256",
          "rubric_version",
          "status",
          "reviewer_id",
          "decision",
          "rationale",
          "ambiguous",
          "review_date"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "submitted"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "type": "string"
                },
                "reviewer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "minLength": 1
                },
                "ambiguous": {
                  "type": "boolean"
                },
                "review_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "annotations"
  ],
  "additionalProperties": false
}
